NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
SEALED_LOG_CONTRACT=redsigma.testnet
NEAR_SIGNER_ACCOUNT=
SEALED_LOG_AGENT=thesis-engine
# Existing NEAR CLI JSON credential, outside this repository.
NEAR_CREDENTIALS_FILE=
INTENTS_API_JWT=
INTENTS_WINDOW_DAYS=30
INTENTS_MAX_PAGES=20
# archive stores complete contributing records in hashed gzip pages for large histories.
INTENTS_EVIDENCE_MODE=inline
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# Every BigQuery query is dry-run before any data query. Decimal byte limits:
BQ_MAX_BYTES_BILLED=20000000000
BQ_MAX_TOTAL_BYTES=60000000000
# Optional frozen UTC end date (exclusive), e.g. 2026-11-14. Empty means today UTC.
DATA_AS_OF_DATE=
